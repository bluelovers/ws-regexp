  ],
  "homepage": "https://github.com/bluelovers/ws-regexp#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-regexp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-regexp.git"
  },
  "workspaces": [
    "packages/@lazy-cjk/*",
    "packages/@regexp-cjk/*",
    "packages/@node-novel/*",
    "packages/*"
  ],
  "scripts": {
    "pretest": "echo pretest",
    "test": "yarn-tool ws run test:since",
    "test:all": "yarn-tool ws run test --concurrency 1",
    "test:jest:clearCache": "jest --clearCache",
    "test:since": "pnpm run test:all -- --since",
    "test:snapshot:all": "yarn-tool ws run test:snapshot --concurrency 1",
    "test:snapshot:since": "pnpm run test:snapshot:all -- --since",
    "test:tsd:all": "yarn-tool ws run test:tsd --concurrency 1",
    "test:tsd:since": "pnpm run test:tsd:all -- --since",
    "install:frozenLockfile": "yarn-tool install --frozen-lockfile",
    "install:reset-lockfile": "yarn-tool install --reset-lockfile",
    "install:resetLockfile": "yarn-tool install --reset-lockfile",
    "build:all": "yarn-tool ws run build --concurrency 1",
    "build:since": "pnpm run build:all -- --since",
    "ci:install": "pnpm install --frozen-lockfile && pnpm add -w typescript@next jest ts-jest ts-node ynpx lerna yarn-tool",
    "ci:build": "echo ci:build",
    "lerna:publish": "pnpm run prepublishOnly:lerna && lerna publish && pnpm run postpublishOnly",
    "lerna:publish:yes": "pnpm run prepublishOnly:check-bin && pnpm run prepublishOnly:lerna && lerna publish --yes --bump patch && pnpm run postpublishOnly",
    "ws:fix-all": "yarn-tool fix-all  --overwriteHostedGitInfo",
    "ws:fix-all:resetStaticFiles": "pnpm run ws:fix-all -- --resetStaticFiles",
    "preversion": "pnpm run test",
    "version": "echo version",
    "postversion": "yarn-tool fix-all",
    "prepublish": "echo prepublish",
    "prepublish:fix-links": "echo skip fix-ws-links (yarn-only)",
    "prepublish:lockfile": "npx sync-lockfile .",
    "prepare": "echo prepare",
    "prepare:fix-ws-links": "echo skip fix-ws-links (yarn-only)",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:lerna": "tsx ./script/run/ws-prepublish.ts",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:lockfile": "ynpx --quiet sync-lockfile",
    "prepublishOnly:root": "pnpm run prepublishOnly:check-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublish:subtree": "tsx ./script/run/postpublish-subtree.ts",
    "postpublish:subtree:cjk-conv": "git subtree push cjk-conv master --prefix packages/cjk-conv",
    "postpublish:subtree:regexp-cjk": "git subtree push regexp-cjk master --prefix packages/regexp-cjk",
    "postpublishOnly": "pnpm run postpublish:subtree",
    "postpublishOnly:ws-root-changelog": "ynpx ws-root-changelog & git add ./CHANGELOG.md & git commit ./CHANGELOG.md -m \"chore(changelog): update changelog toc in workspaces root\" & echo update changelog toc in workspaces root",
    "postpublishOnly:add": "tsx ./script/run/postpublish-add.ts",
    "ncu": "yarn-tool ncu -u --AA",
    "ncu:ws": "yarn-tool ncu -u --AA",
    "ncu:root": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort && yarn-tool ws exec yarn-tool sort",
    "sort-package-json:root": "yarn-tool sort",
    "sort-package-json:ws": "yarn-tool ws sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "resolutions": {},
  "dependencies": {
    "@bluelovers/fast-glob": "^3.0.4",
    "@git-lazy/spawn": "^2.0.3",
    "@lazy-node/readlines": "^3.0.5",
    "@yarn-tool/find-deps": "^3.0.10",
    "@yarn-tool/ws-changed": "^3.0.10",
    "bluebird": "^3.7.2",
    "build-ts-file": "^2.0.4",
    "cross-fetch": "^4.1.0",
    "cross-spawn-extra": "^3.0.3",
    "debug-color2": "^1.3.2",
    "diff": "^9.0.0",
    "expect": "^30.5.1",
    "fs-extra": "^11.4.0",
    "git-root2": "^2.0.3",
    "ignore": "^7.0.8",
    "jest": "^30.5.1",
    "jszip": "^3.10.1",
    "micromatch": "^4.0.8",
    "pretty-format": "^30.5.1",
    "sort-object-keys2": "^3.0.8",
    "ts-jest": "^29.4.12",
    "undici-types": "^8.10.2",
    "uni-string": "^2.0.7",
    "ws-pkg-list": "^3.0.10",
    "xregexp": "^5.1.2",
    "zero-width": "^1.0.29"
  },
  "devDependencies": {
    "@bluelovers/jest-config": "^1.1.11",
    "@bluelovers/tsconfig": "^2.0.3",
    "@types/big.js": "^7.0.0",
    "@types/bluebird": "^3.5.42",
    "@types/diff": "^7.0.2",
    "@types/eslint": "^9.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.25",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.4.1",
    "@types/xregexp": "^4.4.0",
    "@types/yargs": "^17.0.35",
    "@yarn-tool/ws-find-up-paths": "^1.0.21",
    "eslint": "^10.10.0",
    "jest-matcher-utils": "^30.5.1",
    "tslib": "^2.8.1"
  }
}
