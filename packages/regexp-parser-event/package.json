{
  "name": "regexp-parser-event",
  "version": "1.1.49",
  "description": "正規表達式解析器事件處理 (RegExp parser event handling)",
  "keywords": [
    "build",
    "emitter",
    "emoji",
    "event",
    "literal",
    "parser",
    "re",
    "regex",
    "regexp",
    "regular",
    "regular expression"
  ],
  "homepage": "https://github.com/bluelovers/ws-regexp/tree/master/packages/regexp-parser-event#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-regexp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-regexp.git",
    "directory": "packages/regexp-parser-event"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "test": "pnpm run test:local && pnpm run test:regexp",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:local": "jest",
    "test:regexp": "yt ws run --scope regexp-cjk test:local",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "npm:publish:lerna": "npx lerna publish --yes --cd-version patch",
    "preversion": "pnpm run test",
    "prepublish:lockfile": "npx sync-lockfile .",
    "prepublishOnly_": "pnpm run ncu && pnpm run sort-package-json && pnpm run test",
    "postpublish_": "git commit -a -m \"postpublish new version\"",
    "ncu": "npx yarn-tool ncu -u",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "array-hyper-unique": "^2.1.8",
    "regexp-parser-literal": "^1.1.42",
    "regexpp2": "^1.3.37",
    "ts-type": "^3.0.13",
    "tslib": ">=2"
  },
  "devDependencies": {
    "ts-enum-util": "^4.1.0"
  },
