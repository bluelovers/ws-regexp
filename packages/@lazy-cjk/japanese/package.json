{
  "name": "@lazy-cjk/japanese",
  "version": "1.2.39",
  "description": "Util collection for Japanese text processing. Hiraganize, Katakanize, and Romanize.",
  "keywords": [
    "japanese",
    "text",
    "unicode",
    "hiragana",
    "katakana",
    "romaji",
    "romanization",
    "unihan",
    "kanji",
    "hanji",
    "CJK"
  ],
  "homepage": "https://github.com/bluelovers/ws-regexp/tree/master/packages/@lazy-cjk/japanese#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-regexp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-regexp.git",
    "directory": "packages/@lazy-cjk/japanese"
  },
  "license": "MIT",
  "author": "hakatashi <hakatasiloving@gmail.com> (http://hakatashi.com/)",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "test": "pnpm run test:jest",
    "test:jest": "jest",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "npm:publish": "npm publish",
    "npm:publish:lerna": "npx lerna publish --yes --cd-version patch",
    "preversion": "pnpm run test",
    "prepublish:lockfile": "npx sync-lockfile .",
    "postpublish_": "git commit -m \"chore(release): publish\" .",
    "ncu": "npx yarn-tool ncu -u",
    "sort-package-json": "npx yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "lodash": "^4.18.1",
    "ts-type": "^3.0.13",
    "tslib": ">=2"
  },
  "publishConfig": {
    "access": "public"
  },
  "coffeelintConfig": {
    "no_tabs": {
      "level": "ignore"
    },
    "indentation": {
      "level": "error",
      "value": 1
    }
  },
  "gitHead": "2f4c49beba2a9840ad9c5730a13ede00355da70f",
  "testling": {
    "harness": "mocha-bdd",
    "files": "test/*.js",
    "browsers": [
      "ie/6..latest",
      "chrome/latest",
      "firefox/latest"
    ]
  }
}
