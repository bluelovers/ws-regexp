{
  "name": "cjk-conv",
  "version": "1.2.152",
  "description": "convert chinese, japanese 簡繁日漢字轉換 ( merge/split submodule from node-novel, regexp-cjk, str-util )",
  "keywords": [
    "char",
    "character",
    "characters",
    "chinese",
    "cjk",
    "cjk-conv",
    "regexp-cjk",
    "cn",
    "cn2tw",
    "conv",
    "conversion",
    "convert",
    "greedy",
    "hanja",
    "hanzi",
    "japanese",
    "jp2zhs",
    "jp2zht",
    "kanji",
    "node-novel",
    "regex",
    "regexp",
    "regular",
    "regular expression",
    "simplified",
    "slugify",
    "str-util",
    "table",
    "traditional",
    "transform",
    "tw",
    "tw2cn",
    "unicode",
    "util",
    "words",
    "zh",
    "zh-cn",
    "zh-tw",
    "zh2jp",
    "zhs",
    "zht"
  ],
  "homepage": "https://github.com/bluelovers/ws-regexp/tree/master/packages/cjk-conv#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-regexp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-regexp.git",
    "directory": "packages/cjk-conv"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "pretest": "pnpm run check",
    "test": "jest",
    "test:jest": "jest --passWithNoTests",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "build-table": "pnpm --filter @lazy-cjk/zh-convert-table run build && pnpm --filter @lazy-cjk/zh-table-alias run build && pnpm --filter @lazy-cjk/zh-convert run build && pnpm --filter @lazy-cjk/zh-table-greedy run build && pnpm --filter @lazy-cjk/static-build-zh-convert run build",
    "build-table:commit": "pnpm --filter @lazy-cjk/zh-convert-table run build:commit && pnpm --filter @lazy-cjk/zh-table-alias run build:commit && pnpm --filter @lazy-cjk/zh-convert run build:commit && pnpm --filter @lazy-cjk/zh-table-greedy run build:commit && pnpm --filter @lazy-cjk/static-build-zh-convert run build:commit",
    "npm:publish": "npm publish",
    "npm:publish:lerna": "lerna publish --yes --cd-version patch",
    "preversion": "pnpm run test && pnpm run build-table:commit",
    "prepublish:lockfile": "sync-lockfile .",
    "prepublishOnly_": "pnpm run test",
    "postpublish": "pnpm run postpublishOnly:add",
    "postpublish_": "git commit -m \"chore(release): publish\" .",
    "postpublishOnly:add": "pnpm -w run postpublishOnly:add cjk-conv",
    "check": "pnpm run build-table && pnpm run check:list",
    "check:list": "tsx ./test/list.ts",
    "ncu": "yarn-tool ncu -u",
    "precommit": "pnpm run build-table",
    "sort-package-json": "yarn-tool sort"
  },
  "dependencies": {
    "@lazy-cjk/jp-table-alias": "^1.0.49",
    "@lazy-cjk/jp-table-comparison": "^1.0.34",
    "@lazy-cjk/jp-table-convert": "^1.0.54",
    "@lazy-cjk/jp-table-voice": "^1.0.42",
    "@lazy-cjk/novel-filename": "^1.0.59",
    "@lazy-cjk/util": "^1.0.22",
    "@lazy-cjk/zh-convert": "^1.0.57",
    "@lazy-cjk/zh-convert-table": "^1.0.29",
    "@lazy-cjk/zh-slugify": "^1.0.95",
    "@lazy-cjk/zh-table-alias": "^1.0.71",
    "@lazy-cjk/zh-table-greedy": "^1.0.97",
    "@lazy-cjk/zh-table-list": "^1.0.93",
    "tslib": ">=2",
    "uni-string": "^2.0.7"
  },
  "gitHead": "2f4c49beba2a9840ad9c5730a13ede00355da70f"
}
